# Environment Variables Template for CompTestCRM
# Copy this file to .env and fill in the values
# DO NOT commit .env file to version control

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Database connection URL
# Local: jdbc:mysql://localhost:3306/crm?useSSL=false
# AWS RDS: jdbc:mysql://your-rds-endpoint.region.rds.amazonaws.com:3306/crm?useSSL=true
# Azure: jdbc:mysql://your-server.mysql.database.azure.com:3306/crm?useSSL=true
# GCP: jdbc:mysql:///<crm>?cloudSqlInstance=project:region:instance&socketFactory=com.google.cloud.sql.mysql.SocketFactory
DB_URL=jdbc:mysql://localhost:3306/crm?useSSL=false

# Database credentials
DB_USERNAME=root
DB_PASSWORD=password

# Database DDL mode (create-drop, update, validate, none)
# Use 'validate' or 'none' in production
DB_DDL_AUTO=create-drop

# Database connection pool settings
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=5
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000

# ============================================
# FILE STORAGE CONFIGURATION
# ============================================
# Persistent storage paths
# Local: /tmp/pdfs, /tmp/csv, /tmp/uploads
# AWS EFS: /mnt/efs/pdfs, /mnt/efs/csv, /mnt/efs/uploads
# Azure Files: /mnt/azure/pdfs, /mnt/azure/csv, /mnt/azure/uploads
# GCP Filestore: /mnt/gcs/pdfs, /mnt/gcs/csv, /mnt/gcs/uploads
PDF_STORAGE_PATH=/tmp/pdfs
CSV_STORAGE_PATH=/tmp/csv
UPLOAD_STORAGE_PATH=/tmp/uploads

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# Application name
APP_NAME=CompTestCRM

# Server port
SERVER_PORT=8080

# ============================================
# LOGGING CONFIGURATION
# ============================================
# Log levels (TRACE, DEBUG, INFO, WARN, ERROR)
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_SPRING_WEB=INFO
LOG_LEVEL_HIBERNATE=WARN

# ============================================
# ACTUATOR CONFIGURATION
# ============================================
MANAGEMENT_SECURITY_ENABLED=false
MANAGEMENT_CONTEXT_PATH=/appinfo

# ============================================
# THYMELEAF CONFIGURATION
# ============================================
THYMELEAF_MODE=LEGACYHTML5
THYMELEAF_CACHE=false

# ============================================
# AWS CONFIGURATION (Optional)
# ============================================
# AWS Region
# AWS_REGION=us-east-1

# AWS Credentials (use IAM roles instead in production)
# AWS_ACCESS_KEY=
# AWS_SECRET_KEY=

# S3 Configuration
# S3_BUCKET_NAME=
# S3_REGION=us-east-1

# ============================================
# AZURE CONFIGURATION (Optional)
# ============================================
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_KEY=
# AZURE_STORAGE_CONTAINER=

# ============================================
# GCP CONFIGURATION (Optional)
# ============================================
# GCP_PROJECT_ID=
# GCP_BUCKET_NAME=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ============================================
# SECURITY CONFIGURATION (Optional)
# ============================================
# SSL Configuration
# SSL_ENABLED=false
# SSL_KEYSTORE_PATH=
# SSL_KEYSTORE_PASSWORD=
# SSL_KEYSTORE_TYPE=PKCS12

# ============================================
# MONITORING CONFIGURATION (Optional)
# ============================================
# Enable metrics export
# METRICS_EXPORT_ENABLED=true
# METRICS_EXPORT_STEP=60s
